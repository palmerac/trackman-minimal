  "bugs": {
    "url": "https://github.com/aaronpalmer/trackman-minimal/issues"
  },
  "homepage": "https://github.com/aaronpalmer/trackman-minimal#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
